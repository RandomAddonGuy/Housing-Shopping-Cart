	<Frame name="HSC_BrowserHeaderTemplate" mixin="HSC_BrowserHeaderMixin" virtual="true">
		<Size y="28"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Count" inherits="GameFontHighlightSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="-8" y="7"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
					<Size y="14"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="8" y="6"/>
						<Anchor point="RIGHT" relativeKey="$parent.Count" relativePoint="LEFT" x="-8" y="0"/>
					</Anchors>
				</FontString>
				<Texture parentKey="Line">
					<Size y="1"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="6" y="1"/>
						<Anchor point="BOTTOMRIGHT" x="-6" y="1"/>
					</Anchors>
					<Color r="1" g="0.82" b="0" a="0.3"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="HSC_VendorPinTemplate" mixin="HSC_VendorPinMixin" enableMouse="true" virtual="true">
		<Size x="24" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" atlas="Perks-ShoppingCart" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Hover" atlas="Perks-ShoppingCart" alphaMode="ADD" alpha="0.45" setAllPoints="true" hidden="true"/>
				<FontString parentKey="Count" inherits="NumberFontNormalSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="4" y="-3"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
